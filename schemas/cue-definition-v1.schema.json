{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CueDefinition",
  "type": "object",
  "properties": {
    "automation_lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CueAutomationLane"
      }
    },
    "capability_summary": {
      "$ref": "#/$defs/CueCapabilitySummary"
    },
    "compatible_stage_ref": {
      "$ref": "#/$defs/AssetRef"
    },
    "id": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CueLayer"
      }
    },
    "name": {
      "type": "string"
    },
    "nominal_length_ticks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "risk_summary": {
      "$ref": "#/$defs/CueRiskSummary"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "trigger_policy": {
      "$ref": "#/$defs/CueTriggerPolicy"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "compatible_stage_ref",
    "nominal_length_ticks",
    "layers",
    "trigger_policy",
    "capability_summary",
    "risk_summary"
  ],
  "$defs": {
    "AssetRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["id", "revision"]
    },
    "CueAutomationLane": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyframeDSL"
          }
        },
        "target": {
          "$ref": "#/$defs/CueAutomationTarget"
        }
      },
      "additionalProperties": false,
      "required": ["id", "target", "keyframes"]
    },
    "CueAutomationTarget": {
      "type": "object",
      "properties": {
        "layer_id": {
          "type": "string"
        },
        "parameter_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["layer_id", "parameter_id"]
    },
    "CueCapabilitySummary": {
      "type": "object",
      "properties": {
        "required_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CueLayer": {
      "type": "object",
      "properties": {
        "effect_ref": {
          "$ref": "#/$defs/AssetRef"
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "mix_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CueMixOverride"
          }
        },
        "parameter_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParameterValueDSL"
          }
        },
        "phase": {
          "type": "number",
          "format": "double"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "seed": {
          "type": "string"
        },
        "target_set_ref": {
          "$ref": "#/$defs/TargetSetRef"
        },
        "trigger_policy": {
          "$ref": "#/$defs/CueTriggerPolicy"
        }
      },
      "additionalProperties": false,
      "required": ["id", "effect_ref", "target_set_ref", "phase", "seed", "trigger_policy"]
    },
    "CueMixOverride": {
      "type": "object",
      "properties": {
        "attribute_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/MixPolicy"
        }
      },
      "additionalProperties": false,
      "required": ["attribute_id", "policy"]
    },
    "CueQuantize": {
      "type": "string",
      "enum": ["off", "beat", "bar"]
    },
    "CueRiskSummary": {
      "type": "object",
      "properties": {
        "strobe_risk": {
          "$ref": "#/$defs/StrobeRiskDSL"
        }
      },
      "additionalProperties": false,
      "required": ["strobe_risk"]
    },
    "CueTriggerMode": {
      "type": "string",
      "enum": ["timeline", "toggle", "momentary", "one_shot"]
    },
    "CueTriggerPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CueTriggerMode"
        },
        "one_shot_ticks": {
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0
        },
        "quantize": {
          "$ref": "#/$defs/CueQuantize"
        }
      },
      "additionalProperties": false,
      "required": ["mode", "quantize"]
    },
    "DirectionDSL": {
      "type": "string",
      "enum": ["forward", "reverse"]
    },
    "KeyframeDSL": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "in_tangent": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyframeTangentDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpolation": {
          "$ref": "#/$defs/KeyframeInterpolationDSL"
        },
        "out_tangent": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyframeTangentDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/ParameterValueDSL"
        }
      },
      "additionalProperties": false,
      "required": ["id", "time_tick", "value", "interpolation"]
    },
    "KeyframeInterpolationDSL": {
      "type": "string",
      "enum": ["hold", "linear", "ease_in", "ease_out", "ease_in_out", "bezier"]
    },
    "KeyframeTangentDSL": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "format": "double"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["time", "value"]
    },
    "MixPolicy": {
      "type": "string",
      "enum": ["htp", "ltp", "add", "multiply", "mask"]
    },
    "ParameterValueDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direction"
            },
            "value": {
              "$ref": "#/$defs/DirectionDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        }
      ]
    },
    "StrobeRiskDSL": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "TargetSetRef": {
      "type": "object",
      "properties": {
        "stage_id": {
          "type": "string"
        },
        "stage_revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "target_set_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["stage_id", "stage_revision", "target_set_id"]
    }
  }
}
