{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArrangementDocument",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "length_ticks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArrangementMarker"
      }
    },
    "name": {
      "type": "string"
    },
    "ppq": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "tempo_map": {
      "$ref": "#/$defs/TempoMapDSL"
    },
    "time_signatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimeSignaturePoint"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CueTrack"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "ppq",
    "tempo_map",
    "time_signatures",
    "length_ticks",
    "tracks"
  ],
  "$defs": {
    "ArrangementAutomationLane": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyframeDSL"
          }
        },
        "target": {
          "$ref": "#/$defs/ArrangementAutomationTarget"
        }
      },
      "additionalProperties": false,
      "required": ["id", "target", "keyframes"]
    },
    "ArrangementAutomationTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parameter_id": {
              "$ref": "#/$defs/GlobalParameterDSL"
            },
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "additionalProperties": false,
          "required": ["scope", "parameter_id"]
        },
        {
          "type": "object",
          "properties": {
            "clip_id": {
              "type": "string"
            },
            "layer_id": {
              "type": "string"
            },
            "parameter_id": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "const": "cue_layer"
            }
          },
          "additionalProperties": false,
          "required": ["scope", "clip_id", "layer_id", "parameter_id"]
        }
      ]
    },
    "ArrangementMarker": {
      "type": "object",
      "properties": {
        "color": {
          "type": ["string", "null"]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "time_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["id", "time_tick", "name"]
    },
    "AssetRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["id", "revision"]
    },
    "ClipPlaybackDSL": {
      "type": "string",
      "enum": ["once", "loop"]
    },
    "ColorStopDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "position": {
          "type": "number",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["position", "color"]
    },
    "CueClip": {
      "type": "object",
      "properties": {
        "cue_ref": {
          "$ref": "#/$defs/AssetRef"
        },
        "duration_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "layer_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CueLayerOverride"
          }
        },
        "playback": {
          "$ref": "#/$defs/ClipPlaybackDSL",
          "default": "once"
        },
        "source_offset_tick": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "start_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["id", "cue_ref", "start_tick", "duration_tick"]
    },
    "CueLayerOverride": {
      "type": "object",
      "properties": {
        "layer_id": {
          "type": "string"
        },
        "mix_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CueMixOverride"
          }
        },
        "parameter_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ParameterValueDSL"
          }
        },
        "phase": {
          "type": ["number", "null"],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["layer_id"]
    },
    "CueMixOverride": {
      "type": "object",
      "properties": {
        "attribute_id": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/MixPolicy"
        }
      },
      "additionalProperties": false,
      "required": ["attribute_id", "policy"]
    },
    "CueTrack": {
      "type": "object",
      "properties": {
        "automation_lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArrangementAutomationLane"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CueClip"
          }
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "overlap_policy": {
          "$ref": "#/$defs/OverlapPolicyDSL"
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "overlap_policy"]
    },
    "DirectionDSL": {
      "type": "string",
      "enum": ["forward", "reverse"]
    },
    "GlobalParameterDSL": {
      "type": "string",
      "enum": ["master_dimmer"]
    },
    "KeyframeDSL": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "in_tangent": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyframeTangentDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpolation": {
          "$ref": "#/$defs/KeyframeInterpolationDSL"
        },
        "out_tangent": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyframeTangentDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/ParameterValueDSL"
        }
      },
      "additionalProperties": false,
      "required": ["id", "time_tick", "value", "interpolation"]
    },
    "KeyframeInterpolationDSL": {
      "type": "string",
      "enum": ["hold", "linear", "ease_in", "ease_out", "ease_in_out", "bezier"]
    },
    "KeyframeTangentDSL": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "format": "double"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["time", "value"]
    },
    "MixPolicy": {
      "type": "string",
      "enum": ["htp", "ltp", "add", "multiply", "mask"]
    },
    "OverlapPolicyDSL": {
      "type": "string",
      "enum": ["layer", "replace", "reject", "crossfade"]
    },
    "ParameterValueDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direction"
            },
            "value": {
              "$ref": "#/$defs/DirectionDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color_stops"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColorStopDSL"
              }
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        }
      ]
    },
    "TempoMapDSL": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempoPointDSL"
          }
        }
      },
      "additionalProperties": false,
      "required": ["points"]
    },
    "TempoPointDSL": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "number",
          "format": "double",
          "maximum": 1000.0,
          "minimum": 1.0
        },
        "time_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["time_tick", "bpm"]
    },
    "TimeSignaturePoint": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint8",
          "maximum": 32,
          "minimum": 1
        },
        "numerator": {
          "type": "integer",
          "format": "uint8",
          "maximum": 32,
          "minimum": 1
        },
        "time_tick": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["time_tick", "numerator", "denominator"]
    }
  }
}
