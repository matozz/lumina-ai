{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShowDocumentV1",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupDSL"
      }
    },
    "layout": {
      "$ref": "#/$defs/LayoutDSL"
    },
    "meta": {
      "$ref": "#/$defs/MetaDSL"
    },
    "patch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchDSL"
      }
    },
    "phasers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhaserDSL"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "timeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineDSL"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "patch",
    "layout",
    "groups",
    "phasers"
  ],
  "$defs": {
    "AnimatableValueDSL": {
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "CustomFixturePos": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y"
      ]
    },
    "EasingDSL": {
      "type": "string",
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out"
      ]
    },
    "FormulaDef": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "t_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "t_range",
        "count"
      ]
    },
    "GeneratorDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "origin": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "shape": {
              "type": "string",
              "const": "matrix"
            },
            "spacing": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "rows",
            "columns",
            "spacing"
          ]
        },
        {
          "type": "object",
          "properties": {
            "center": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "gap": {
              "type": "number",
              "format": "double"
            },
            "increment": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "rings": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "shape": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "rings",
            "increment",
            "gap"
          ]
        },
        {
          "type": "object",
          "properties": {
            "formula": {
              "$ref": "#/$defs/FormulaDef"
            },
            "shape": {
              "type": "string",
              "const": "formula"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "formula"
          ]
        },
        {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "svg_path"
            },
            "svgPath": {
              "$ref": "#/$defs/SvgPathDef"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "svgPath"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fixtures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomFixturePos"
              }
            },
            "shape": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "fixtures"
          ]
        }
      ]
    },
    "GroupDSL": {
      "type": "object",
      "properties": {
        "fixtures": {
          "$ref": "#/$defs/GroupFixturesDSL"
        },
        "name": {
          "type": "string"
        },
        "sort_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "fixtures"
      ]
    },
    "GroupFixturesDSL": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        {
          "$ref": "#/$defs/GroupRangeDSL"
        }
      ]
    },
    "GroupRangeDSL": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "range"
      ]
    },
    "LayoutDSL": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/GeneratorDSL"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "generator"
      ]
    },
    "MetaDSL": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "PatchDSL": {
      "type": "object",
      "properties": {
        "id_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id_range"
      ]
    },
    "PhaseConfigDSL": {
      "type": "object",
      "properties": {
        "grouped": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseGroupedDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string"
        },
        "spread": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseSpreadDSL"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "PhaseGroupedDSL": {
      "type": "object",
      "properties": {
        "group_size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "spread": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "group_size",
        "spread"
      ]
    },
    "PhaseSpreadDSL": {
      "type": "object",
      "properties": {
        "from": {
          "type": "number",
          "format": "double"
        },
        "to": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "PhaserDSL": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "multiplier": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PhaseConfigDSL"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhaserStepDSL"
          }
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "target",
        "steps",
        "phase"
      ]
    },
    "PhaserStepDSL": {
      "type": "object",
      "properties": {
        "accel": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "decel": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "transition": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "values": {
          "$ref": "#/$defs/StepValuesDSL"
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "values"
      ]
    },
    "StepValuesDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimmer": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "pan": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "tilt": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "SvgPathDef": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "d",
        "sample_count"
      ]
    },
    "TimelineActionDefDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "phaser": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "phaser"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "phaser"
          ]
        },
        {
          "type": "object",
          "properties": {
            "easing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EasingDSL"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "$ref": "#/$defs/AnimatableValueDSL"
            },
            "target": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/AnimatableValueDSL"
            },
            "type": {
              "type": "string",
              "const": "animate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "target",
            "from",
            "to"
          ]
        }
      ]
    },
    "TimelineDSL": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineEventDSL"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "events"
      ]
    },
    "TimelineEventDSL": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionDefDSL"
        },
        "beat": {
          "type": "number",
          "format": "double"
        },
        "duration": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "beat",
        "action"
      ]
    }
  }
}
