{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShowDocumentV1",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupDSL"
      }
    },
    "layout": {
      "$ref": "#/$defs/LayoutDSL"
    },
    "meta": {
      "$ref": "#/$defs/MetaDSL"
    },
    "patch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchDSL"
      }
    },
    "phasers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhaserDSL"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "timeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimelineDSL"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": ["schema_version", "meta", "patch", "layout", "groups", "phasers"],
  "$defs": {
    "AnimatableValueDSL": {
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "AutomationTargetDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "parameter_id": {
              "$ref": "#/$defs/GlobalParameterDSL"
            },
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "additionalProperties": false,
          "required": ["scope", "parameter_id"]
        },
        {
          "type": "object",
          "properties": {
            "instance_id": {
              "type": "string"
            },
            "parameter_id": {
              "$ref": "#/$defs/EffectParameterDSL"
            },
            "scope": {
              "type": "string",
              "const": "effect_instance"
            }
          },
          "additionalProperties": false,
          "required": ["scope", "instance_id", "parameter_id"]
        }
      ]
    },
    "CustomFixturePos": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["id", "x", "y"]
    },
    "EasingDSL": {
      "type": "string",
      "enum": ["linear", "ease_in", "ease_out", "ease_in_out"]
    },
    "EffectParameterDSL": {
      "type": "string",
      "enum": ["multiplier", "color", "dimmer", "pan", "tilt"]
    },
    "FormulaDef": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        },
        "t_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["x", "y", "t_range", "count"]
    },
    "GeneratorDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "origin": {
              "type": ["array", "null"],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "matrix"
            },
            "spacing": {
              "type": "number",
              "format": "double",
              "minimum": 1e-6
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rows", "columns", "spacing"]
        },
        {
          "type": "object",
          "properties": {
            "center": {
              "type": ["array", "null"],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "gap": {
              "type": "number",
              "format": "double",
              "minimum": 1e-6
            },
            "increment": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "rings": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rings", "increment", "gap"]
        },
        {
          "type": "object",
          "properties": {
            "formula": {
              "$ref": "#/$defs/FormulaDef"
            },
            "shape": {
              "type": "string",
              "const": "formula"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "formula"]
        },
        {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "svg_path"
            },
            "svgPath": {
              "$ref": "#/$defs/SvgPathDef"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "svgPath"]
        },
        {
          "type": "object",
          "properties": {
            "fixtures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomFixturePos"
              }
            },
            "shape": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "fixtures"]
        }
      ]
    },
    "GlobalParameterDSL": {
      "type": "string",
      "enum": ["master_dimmer"]
    },
    "GroupDSL": {
      "type": "object",
      "properties": {
        "fixtures": {
          "$ref": "#/$defs/GroupFixturesDSL"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sort_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortByDSL"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "fixtures"]
    },
    "GroupFixturesDSL": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        {
          "$ref": "#/$defs/GroupRangeDSL"
        }
      ]
    },
    "GroupRangeDSL": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["range"]
    },
    "LayoutDSL": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/GeneratorDSL"
        },
        "type": {
          "$ref": "#/$defs/LayoutType"
        }
      },
      "additionalProperties": false,
      "required": ["type", "generator"]
    },
    "LayoutType": {
      "type": "string",
      "enum": ["generator"]
    },
    "LegacyFixtureType": {
      "type": "string",
      "enum": ["spot", "pixel"]
    },
    "MetaDSL": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["name"]
    },
    "PatchDSL": {
      "type": "object",
      "properties": {
        "id_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "type": {
          "$ref": "#/$defs/LegacyFixtureType"
        }
      },
      "additionalProperties": false,
      "required": ["type", "id_range"]
    },
    "PhaseConfigDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "spread"
            },
            "spread": {
              "$ref": "#/$defs/PhaseSpreadDSL"
            }
          },
          "additionalProperties": false,
          "required": ["mode", "spread"]
        },
        {
          "type": "object",
          "properties": {
            "grouped": {
              "$ref": "#/$defs/PhaseGroupedDSL"
            },
            "mode": {
              "type": "string",
              "const": "grouped"
            }
          },
          "additionalProperties": false,
          "required": ["mode", "grouped"]
        }
      ]
    },
    "PhaseGroupedDSL": {
      "type": "object",
      "properties": {
        "group_size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "spread": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["group_size", "spread"]
    },
    "PhaseSpreadDSL": {
      "type": "object",
      "properties": {
        "from": {
          "type": "number",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "to": {
          "type": "number",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["from", "to"]
    },
    "PhaserDSL": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "multiplier": {
          "type": ["number", "null"],
          "format": "double",
          "minimum": 1e-6
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/PhaseConfigDSL"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhaserStepDSL"
          }
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "target", "steps", "phase"]
    },
    "PhaserStepDSL": {
      "type": "object",
      "properties": {
        "accel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "decel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "transition": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "values": {
          "$ref": "#/$defs/StepValuesDSL"
        },
        "width": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["values"]
    },
    "SortByDSL": {
      "type": "string",
      "enum": [
        "none",
        "x",
        "-x",
        "y",
        "-y",
        "distance_center",
        "-distance_center",
        "angle_center",
        "-angle_center",
        "random",
        "x+y",
        "-(x+y)"
      ]
    },
    "StepValuesDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": ["string", "null"]
        },
        "dimmer": {
          "type": ["number", "null"],
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "pan": {
          "type": ["number", "null"],
          "format": "float"
        },
        "tilt": {
          "type": ["number", "null"],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "SvgPathDef": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["d", "sample_count"]
    },
    "TimelineActionDefDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "phaser": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "phaser"
            }
          },
          "additionalProperties": false,
          "required": ["type", "phaser"]
        },
        {
          "type": "object",
          "properties": {
            "easing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EasingDSL"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "$ref": "#/$defs/AnimatableValueDSL"
            },
            "target": {
              "$ref": "#/$defs/AutomationTargetDSL"
            },
            "to": {
              "$ref": "#/$defs/AnimatableValueDSL"
            },
            "type": {
              "type": "string",
              "const": "animate"
            }
          },
          "additionalProperties": false,
          "required": ["type", "target", "from", "to"]
        }
      ]
    },
    "TimelineDSL": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineEventDSL"
          }
        }
      },
      "additionalProperties": false,
      "required": ["events"]
    },
    "TimelineEventDSL": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionDefDSL"
        },
        "beat": {
          "type": "number",
          "format": "double",
          "minimum": 0.0
        },
        "duration": {
          "type": ["number", "null"],
          "format": "double",
          "minimum": 1e-6
        }
      },
      "additionalProperties": false,
      "required": ["beat", "action"]
    }
  }
}
