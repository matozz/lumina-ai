{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageDocument",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupDSL"
      }
    },
    "id": {
      "type": "string"
    },
    "layout_ref": {
      "$ref": "#/$defs/AssetRef"
    },
    "name": {
      "type": "string"
    },
    "patch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchDSL"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "target_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TargetSetDefinition"
      }
    },
    "targeting_scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TargetingSceneDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "patch",
    "layout_ref",
    "groups",
    "target_sets"
  ],
  "$defs": {
    "AssetRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["id", "revision"]
    },
    "CenterEdgesRegion": {
      "type": "string",
      "enum": ["center", "edges"]
    },
    "CheckerboardParity": {
      "type": "string",
      "enum": ["even", "odd"]
    },
    "GridZone": {
      "type": "object",
      "properties": {
        "column": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["row", "column"]
    },
    "GroupDSL": {
      "type": "object",
      "properties": {
        "fixtures": {
          "$ref": "#/$defs/GroupFixturesDSL"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sort_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortByDSL"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "fixtures"]
    },
    "GroupFixturesDSL": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        {
          "$ref": "#/$defs/GroupRangeDSL"
        }
      ]
    },
    "GroupRangeDSL": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["range"]
    },
    "PatchDSL": {
      "type": "object",
      "properties": {
        "id_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "profile_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["profile_id", "id_range"]
    },
    "SortByDSL": {
      "type": "string",
      "enum": [
        "none",
        "x",
        "-x",
        "y",
        "-y",
        "distance_center",
        "-distance_center",
        "angle_center",
        "-angle_center",
        "random",
        "x+y",
        "-(x+y)"
      ]
    },
    "TargetSetDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/TargetSetSelector"
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetSetWeight"
          }
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "selector"]
    },
    "TargetSetSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "rows"
            }
          },
          "additionalProperties": false,
          "required": ["type", "indices"]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "columns"
            }
          },
          "additionalProperties": false,
          "required": ["type", "indices"]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "const": "grid_zones"
            },
            "zones": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GridZone"
              }
            }
          },
          "additionalProperties": false,
          "required": ["type", "rows", "columns", "zones"]
        },
        {
          "type": "object",
          "properties": {
            "parity": {
              "$ref": "#/$defs/CheckerboardParity"
            },
            "type": {
              "type": "string",
              "const": "checkerboard"
            }
          },
          "additionalProperties": false,
          "required": ["type", "parity"]
        },
        {
          "type": "object",
          "properties": {
            "region": {
              "$ref": "#/$defs/CenterEdgesRegion"
            },
            "thickness": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "const": "center_edges"
            }
          },
          "additionalProperties": false,
          "required": ["type", "region", "thickness"]
        },
        {
          "type": "object",
          "properties": {
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "fixture_ids"
            }
          },
          "additionalProperties": false,
          "required": ["type", "fixture_ids"]
        }
      ]
    },
    "TargetSetWeight": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["fixture_id", "weight"]
    },
    "TargetingDuration": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/TargetingDurationUnit"
        },
        "value": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": ["value", "unit"]
    },
    "TargetingDurationUnit": {
      "type": "string",
      "enum": ["beat", "bar"]
    },
    "TargetingSceneDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "looped": {
          "type": "boolean",
          "default": false
        },
        "name": {
          "type": "string"
        },
        "phase_continuity": {
          "type": "boolean",
          "default": true
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetingSceneStep"
          }
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "steps"]
    },
    "TargetingSceneStep": {
      "type": "object",
      "properties": {
        "duration": {
          "$ref": "#/$defs/TargetingDuration"
        },
        "id": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/TargetingSelection"
        },
        "transition": {
          "$ref": "#/$defs/TargetingTransition"
        }
      },
      "additionalProperties": false,
      "required": ["id", "selection", "duration", "transition"]
    },
    "TargetingSelection": {
      "type": "object",
      "properties": {
        "partition_index": {
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0
        },
        "target_set_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["target_set_id"]
    },
    "TargetingTransition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hard"
            }
          },
          "additionalProperties": false,
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "duration": {
              "$ref": "#/$defs/TargetingDuration"
            },
            "type": {
              "type": "string",
              "const": "weighted"
            }
          },
          "additionalProperties": false,
          "required": ["type", "duration"]
        }
      ]
    }
  }
}
