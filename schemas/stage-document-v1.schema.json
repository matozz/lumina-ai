{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageDocument",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupDSL"
      }
    },
    "id": {
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/LayoutDSL"
    },
    "name": {
      "type": "string"
    },
    "patch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PatchDSL"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "target_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TargetSetDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "name",
    "patch",
    "layout",
    "groups",
    "target_sets"
  ],
  "$defs": {
    "CheckerboardParity": {
      "type": "string",
      "enum": ["even", "odd"]
    },
    "CustomFixturePos": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["id", "x", "y"]
    },
    "FormulaDef": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        },
        "t_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["x", "y", "t_range", "count"]
    },
    "GeneratorDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "origin": {
              "type": ["array", "null"],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "matrix"
            },
            "spacing": {
              "type": "number",
              "format": "double",
              "minimum": 1e-6
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rows", "columns", "spacing"]
        },
        {
          "type": "object",
          "properties": {
            "center": {
              "type": ["array", "null"],
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "gap": {
              "type": "number",
              "format": "double",
              "minimum": 1e-6
            },
            "increment": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "rings": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rings", "increment", "gap"]
        },
        {
          "type": "object",
          "properties": {
            "formula": {
              "$ref": "#/$defs/FormulaDef"
            },
            "shape": {
              "type": "string",
              "const": "formula"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "formula"]
        },
        {
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "svg_path"
            },
            "svgPath": {
              "$ref": "#/$defs/SvgPathDef"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "svgPath"]
        },
        {
          "type": "object",
          "properties": {
            "fixtures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomFixturePos"
              }
            },
            "shape": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "fixtures"]
        }
      ]
    },
    "GridZone": {
      "type": "object",
      "properties": {
        "column": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["row", "column"]
    },
    "GroupDSL": {
      "type": "object",
      "properties": {
        "fixtures": {
          "$ref": "#/$defs/GroupFixturesDSL"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sort_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortByDSL"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "fixtures"]
    },
    "GroupFixturesDSL": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        {
          "$ref": "#/$defs/GroupRangeDSL"
        }
      ]
    },
    "GroupRangeDSL": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["range"]
    },
    "LayoutDSL": {
      "type": "object",
      "properties": {
        "generator": {
          "$ref": "#/$defs/GeneratorDSL"
        },
        "type": {
          "$ref": "#/$defs/LayoutType"
        }
      },
      "additionalProperties": false,
      "required": ["type", "generator"]
    },
    "LayoutType": {
      "type": "string",
      "enum": ["generator"]
    },
    "PatchDSL": {
      "type": "object",
      "properties": {
        "id_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "profile_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["profile_id", "id_range"]
    },
    "SortByDSL": {
      "type": "string",
      "enum": [
        "none",
        "x",
        "-x",
        "y",
        "-y",
        "distance_center",
        "-distance_center",
        "angle_center",
        "-angle_center",
        "random",
        "x+y",
        "-(x+y)"
      ]
    },
    "SvgPathDef": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["d", "sample_count"]
    },
    "TargetSetDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/TargetSetSelector"
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetSetWeight"
          }
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "selector"]
    },
    "TargetSetSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "rows"
            }
          },
          "additionalProperties": false,
          "required": ["type", "indices"]
        },
        {
          "type": "object",
          "properties": {
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "columns"
            }
          },
          "additionalProperties": false,
          "required": ["type", "indices"]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "const": "grid_zones"
            },
            "zones": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GridZone"
              }
            }
          },
          "additionalProperties": false,
          "required": ["type", "rows", "columns", "zones"]
        },
        {
          "type": "object",
          "properties": {
            "parity": {
              "$ref": "#/$defs/CheckerboardParity"
            },
            "type": {
              "type": "string",
              "const": "checkerboard"
            }
          },
          "additionalProperties": false,
          "required": ["type", "parity"]
        },
        {
          "type": "object",
          "properties": {
            "fixture_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "fixture_ids"
            }
          },
          "additionalProperties": false,
          "required": ["type", "fixture_ids"]
        }
      ]
    },
    "TargetSetWeight": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["fixture_id", "weight"]
    }
  }
}
