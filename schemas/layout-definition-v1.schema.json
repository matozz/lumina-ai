{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LayoutDefinition",
  "type": "object",
  "properties": {
    "category": {
      "$ref": "#/$defs/LayoutCategory"
    },
    "editor": {
      "$ref": "#/$defs/LayoutEditorCapability"
    },
    "geometry": {
      "$ref": "#/$defs/LayoutGeometry"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "name", "category", "editor", "geometry"],
  "$defs": {
    "CustomFixturePos": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["id", "x", "y"]
    },
    "FormulaDef": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        },
        "t_range": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["x", "y", "t_range", "count"]
    },
    "LayoutAlgorithm": {
      "type": "string",
      "enum": ["lissajous", "spiral"]
    },
    "LayoutCategory": {
      "type": "string",
      "enum": ["basic", "generated_advanced"]
    },
    "LayoutEditorCapability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "form"
            }
          },
          "additionalProperties": false,
          "required": ["mode"]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "parameter_schema"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LayoutParameterDefinition"
              }
            }
          },
          "additionalProperties": false,
          "required": ["mode", "parameters"]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "advanced_only"
            }
          },
          "additionalProperties": false,
          "required": ["mode"]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "read_only"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["mode", "reason"]
        }
      ]
    },
    "LayoutGap": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double",
          "minimum": 0.0
        },
        "y": {
          "type": "number",
          "format": "double",
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["x", "y"]
    },
    "LayoutGeometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "gap": {
              "$ref": "#/$defs/LayoutGap"
            },
            "origin": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "pitch": {
              "$ref": "#/$defs/LayoutPitch"
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "matrix"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rows", "columns", "fixture_size", "gap", "pitch", "origin"]
        },
        {
          "type": "object",
          "properties": {
            "center": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "increment": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "ring_gap": {
              "type": "number",
              "format": "double",
              "minimum": 0.0
            },
            "ring_pitch": {
              "type": "number",
              "format": "double",
              "minimum": 1e-6
            },
            "rings": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "shape",
            "rings",
            "increment",
            "fixture_size",
            "ring_gap",
            "ring_pitch",
            "center"
          ]
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "gap": {
              "$ref": "#/$defs/LayoutGap"
            },
            "orientation": {
              "$ref": "#/$defs/LayoutOrientation"
            },
            "origin": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "pitch": {
              "$ref": "#/$defs/LayoutPitch"
            },
            "shape": {
              "type": "string",
              "const": "strip"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "count", "orientation", "fixture_size", "gap", "pitch", "origin"]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "gap": {
              "$ref": "#/$defs/LayoutGap"
            },
            "origin": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "pitch": {
              "$ref": "#/$defs/LayoutPitch"
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1
            },
            "shape": {
              "type": "string",
              "const": "wall"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rows", "columns", "fixture_size", "gap", "pitch", "origin"]
        },
        {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "format": "uint32",
              "minimum": 2
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "gap": {
              "$ref": "#/$defs/LayoutGap"
            },
            "origin": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "pitch": {
              "$ref": "#/$defs/LayoutPitch"
            },
            "rows": {
              "type": "integer",
              "format": "uint32",
              "minimum": 2
            },
            "shape": {
              "type": "string",
              "const": "frame"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "rows", "columns", "fixture_size", "gap", "pitch", "origin"]
        },
        {
          "type": "object",
          "properties": {
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "formula": {
              "$ref": "#/$defs/FormulaDef"
            },
            "shape": {
              "type": "string",
              "const": "formula"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "formula", "fixture_size"]
        },
        {
          "type": "object",
          "properties": {
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "shape": {
              "type": "string",
              "const": "svg_path"
            },
            "svg_path": {
              "$ref": "#/$defs/SvgPathDef"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "svg_path", "fixture_size"]
        },
        {
          "type": "object",
          "properties": {
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "fixtures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomFixturePos"
              }
            },
            "shape": {
              "type": "string",
              "const": "custom"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "fixtures", "fixture_size"]
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "$ref": "#/$defs/LayoutAlgorithm"
            },
            "count": {
              "type": "integer",
              "format": "uint32",
              "maximum": 1000000,
              "minimum": 1
            },
            "fixture_size": {
              "$ref": "#/$defs/LayoutSize"
            },
            "origin": {
              "$ref": "#/$defs/LayoutPoint"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            },
            "shape": {
              "type": "string",
              "const": "algorithm"
            }
          },
          "additionalProperties": false,
          "required": ["shape", "algorithm", "count", "fixture_size", "origin", "parameters"]
        }
      ]
    },
    "LayoutOrientation": {
      "type": "string",
      "enum": ["horizontal", "vertical"]
    },
    "LayoutParameterDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "maximum": {
          "type": ["number", "null"],
          "format": "double"
        },
        "minimum": {
          "type": ["number", "null"],
          "format": "double"
        },
        "step": {
          "type": ["number", "null"],
          "format": "double"
        },
        "value_type": {
          "$ref": "#/$defs/LayoutParameterValueType"
        }
      },
      "additionalProperties": false,
      "required": ["id", "label", "value_type"]
    },
    "LayoutParameterValueType": {
      "type": "string",
      "enum": ["number", "integer", "text"]
    },
    "LayoutPitch": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        },
        "y": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        }
      },
      "additionalProperties": false,
      "required": ["x", "y"]
    },
    "LayoutPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["x", "y"]
    },
    "LayoutSize": {
      "type": "object",
      "properties": {
        "height": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        },
        "width": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        }
      },
      "additionalProperties": false,
      "required": ["width", "height"]
    },
    "SvgPathDef": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "format": "uint32",
          "maximum": 1000000,
          "minimum": 1
        },
        "scale": {
          "type": ["number", "null"],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["d", "sample_count"]
    }
  }
}
