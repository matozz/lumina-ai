{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectDefinitionDocument",
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/EffectCatalogDSL"
    },
    "graph": {
      "$ref": "#/$defs/EffectGraphDSL"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParameterDefinitionDSL"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/EffectSourceDSL"
    },
    "tempo": {
      "$ref": "#/$defs/EffectTempoBehaviorDSL"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "revision",
    "source",
    "parameters",
    "tempo",
    "graph",
    "catalog"
  ],
  "$defs": {
    "CatalogVisibilityDSL": {
      "type": "string",
      "enum": ["standard", "advanced", "hidden"]
    },
    "ColorStopDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "position": {
          "type": "number",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["position", "color"]
    },
    "DirectionDSL": {
      "type": "string",
      "enum": ["forward", "reverse"]
    },
    "EffectCatalogDSL": {
      "type": "object",
      "properties": {
        "category": {
          "type": ["string", "null"]
        },
        "colorfulness": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "density": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "energy": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "family": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectFamilyDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutCapabilityDSL"
          }
        },
        "mood": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "$ref": "#/$defs/MotionTagDSL"
        },
        "required_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strobe_risk": {
          "$ref": "#/$defs/StrobeRiskDSL"
        },
        "visibility": {
          "$ref": "#/$defs/CatalogVisibilityDSL",
          "default": "standard"
        }
      },
      "additionalProperties": false,
      "required": ["energy", "density", "motion", "colorfulness", "strobe_risk"]
    },
    "EffectFamilyDSL": {
      "type": "string",
      "enum": ["intensity", "color", "movement", "spatial", "strobe", "utility"]
    },
    "EffectGraphDSL": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectNodeDSL"
          }
        }
      },
      "additionalProperties": false,
      "required": ["nodes"]
    },
    "EffectNodeDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "time"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "constant"
            },
            "value": {
              "$ref": "#/$defs/ParameterValueDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "value"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "random"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "phase": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SequenceStepDSL"
              }
            },
            "type": {
              "type": "string",
              "const": "step_sequence"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "phase", "steps"]
        },
        {
          "type": "object",
          "properties": {
            "duty_cycle": {
              "type": ["number", "null"],
              "format": "double",
              "maximum": 1.0,
              "minimum": 1e-6
            },
            "id": {
              "type": "string"
            },
            "phase": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "type": {
              "type": "string",
              "const": "oscillator"
            },
            "waveform": {
              "$ref": "#/$defs/OscillatorWaveformDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "waveform", "phase"]
        },
        {
          "type": "object",
          "properties": {
            "attack": {
              "type": "number",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "release": {
              "type": "number",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "const": "envelope"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "attack", "release"]
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "$ref": "#/$defs/SpatialBasisDSL"
            },
            "custom_order": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "from": {
              "type": "number",
              "format": "double"
            },
            "group_size": {
              "type": ["integer", "null"],
              "format": "uint32",
              "minimum": 0
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "to": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "spatial_phase"
            },
            "wrap": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "basis", "from", "to", "wrap"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "left": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "operation": {
              "$ref": "#/$defs/MathOperationDSL"
            },
            "right": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "type": {
              "type": "string",
              "const": "math"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "operation", "left", "right"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "input_range": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "output_range": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "map"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "input_range", "output_range"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "clamp"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "min", "max"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColorStopDSL"
              }
            },
            "type": {
              "type": "string",
              "const": "color_gradient"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "stops"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "fixture_mask"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "min", "max"]
        },
        {
          "type": "object",
          "properties": {
            "attribute_id": {
              "type": ["string", "null"]
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "mask": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EffectPortRefDSL"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "attribute_writer"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input"]
        }
      ]
    },
    "EffectNodePropertyDSL": {
      "type": "string",
      "enum": ["waveform", "duty_cycle", "attack", "release", "color_stops"]
    },
    "EffectPortDSL": {
      "type": "string",
      "enum": [
        "scalar",
        "color",
        "direction",
        "boolean",
        "enum",
        "color_stops",
        "mask",
        "attribute_set",
        "writes"
      ]
    },
    "EffectPortRefDSL": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/EffectPortDSL"
        }
      },
      "additionalProperties": false,
      "required": ["node_id", "port"]
    },
    "EffectSourceDSL": {
      "type": "string",
      "enum": ["built_in", "project_local", "user_library"]
    },
    "EffectTempoBehaviorDSL": {
      "type": "object",
      "properties": {
        "events_per_graph_cycle": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        },
        "primary_event": {
          "$ref": "#/$defs/PrimaryVisualEventDSL"
        },
        "safety": {
          "anyOf": [
            {
              "$ref": "#/$defs/TempoSafetyLimitDSL"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["primary_event", "events_per_graph_cycle"]
    },
    "LayoutCapabilityDSL": {
      "type": "string",
      "enum": ["any", "linear", "matrix", "radial", "coordinates", "targeting_scene"]
    },
    "MathOperationDSL": {
      "type": "string",
      "enum": ["add", "subtract", "multiply", "divide", "min", "max"]
    },
    "MotionTagDSL": {
      "type": "string",
      "enum": ["static", "pulse", "chase", "sweep", "organic"]
    },
    "OscillatorWaveformDSL": {
      "type": "string",
      "enum": ["sine", "triangle", "saw", "pulse"]
    },
    "ParameterDefinitionDSL": {
      "type": "object",
      "properties": {
        "graph_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterGraphBindingDSL"
            },
            {
              "type": "null"
            }
          ]
        },
        "help": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/ParameterSchemaDSL"
        },
        "scope": {
          "$ref": "#/$defs/ParameterScopeDSL"
        },
        "section": {
          "$ref": "#/$defs/ParameterSectionDSL"
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "schema", "scope", "section", "help"]
    },
    "ParameterGraphBindingDSL": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "property": {
          "$ref": "#/$defs/EffectNodePropertyDSL"
        }
      },
      "additionalProperties": false,
      "required": ["node_id", "property"]
    },
    "ParameterSchemaDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number",
              "format": "double"
            },
            "range": {
              "$ref": "#/$defs/ScalarParameterRangeDSL"
            },
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "unit": {
              "$ref": "#/$defs/ScalarParameterUnitDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "default", "range", "unit"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": ["string", "null"]
            },
            "type": {
              "type": "string",
              "const": "color"
            }
          },
          "additionalProperties": false,
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "$ref": "#/$defs/DirectionDSL"
            },
            "type": {
              "type": "string",
              "const": "direction"
            }
          },
          "additionalProperties": false,
          "required": ["type", "default"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "additionalProperties": false,
          "required": ["type", "default"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": ["type", "default", "values"]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColorStopDSL"
              }
            },
            "type": {
              "type": "string",
              "const": "color_stops"
            }
          },
          "additionalProperties": false,
          "required": ["type", "default"]
        }
      ]
    },
    "ParameterScopeDSL": {
      "type": "string",
      "enum": ["effect", "cue", "arrangement"]
    },
    "ParameterSectionDSL": {
      "type": "string",
      "enum": ["main", "advanced"]
    },
    "ParameterValueDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direction"
            },
            "value": {
              "$ref": "#/$defs/DirectionDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color_stops"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColorStopDSL"
              }
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        }
      ]
    },
    "PrimaryVisualEventDSL": {
      "type": "string",
      "enum": [
        "pulse_onset",
        "one_way_traversal",
        "directional_traversal",
        "random_refresh",
        "rise_fall_cycle",
        "color_cycle",
        "movement_cycle",
        "spatial_propagation"
      ]
    },
    "ScalarParameterRangeDSL": {
      "type": "object",
      "properties": {
        "max": {
          "type": "number",
          "format": "double"
        },
        "min": {
          "type": "number",
          "format": "double"
        },
        "step": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["min", "max", "step"]
    },
    "ScalarParameterUnitDSL": {
      "type": "string",
      "enum": ["none", "multiplier", "cycles", "percent", "normalized", "degrees"]
    },
    "SequenceStepDSL": {
      "type": "object",
      "properties": {
        "accel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "decel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "transition": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "values": {
          "$ref": "#/$defs/StepValuesDSL"
        },
        "width": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["values"]
    },
    "SpatialBasisDSL": {
      "type": "string",
      "enum": ["index", "x", "random_x", "y", "distance", "angle", "custom"]
    },
    "StepValuesDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": ["string", "null"]
        },
        "dimmer": {
          "type": ["number", "null"],
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "pan": {
          "type": ["number", "null"],
          "format": "float"
        },
        "tilt": {
          "type": ["number", "null"],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "StrobeRiskDSL": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "TempoSafetyLimitDSL": {
      "type": "object",
      "properties": {
        "max_primary_events_per_second": {
          "type": "number",
          "format": "double",
          "minimum": 1e-6
        }
      },
      "additionalProperties": false,
      "required": ["max_primary_events_per_second"]
    }
  }
}
