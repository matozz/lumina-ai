{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectDefinitionDocument",
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/EffectCatalogDSL"
    },
    "graph": {
      "$ref": "#/$defs/EffectGraphDSL"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParameterDefinitionDSL"
      }
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/EffectSourceDSL"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "revision",
    "source",
    "parameters",
    "graph",
    "catalog"
  ],
  "$defs": {
    "AutomationPolicyDSL": {
      "type": "string",
      "enum": ["continuous", "discrete"]
    },
    "ColorStopDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "position": {
          "type": "number",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["position", "color"]
    },
    "DirectionDSL": {
      "type": "string",
      "enum": ["forward", "reverse"]
    },
    "EffectCatalogDSL": {
      "type": "object",
      "properties": {
        "colorfulness": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "density": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "energy": {
          "type": "number",
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "mood": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "$ref": "#/$defs/MotionTagDSL"
        },
        "required_attributes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strobe_risk": {
          "$ref": "#/$defs/StrobeRiskDSL"
        }
      },
      "additionalProperties": false,
      "required": ["energy", "density", "motion", "colorfulness", "strobe_risk"]
    },
    "EffectGraphDSL": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectNodeDSL"
          }
        }
      },
      "additionalProperties": false,
      "required": ["nodes"]
    },
    "EffectNodeDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "time"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "constant"
            },
            "value": {
              "$ref": "#/$defs/ParameterValueDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "value"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "random"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "phase": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PhaserStepDSL"
              }
            },
            "type": {
              "type": "string",
              "const": "step_sequence"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "phase", "steps"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "phase": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "type": {
              "type": "string",
              "const": "oscillator"
            },
            "waveform": {
              "$ref": "#/$defs/OscillatorWaveformDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "waveform", "phase"]
        },
        {
          "type": "object",
          "properties": {
            "attack": {
              "type": "number",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "release": {
              "type": "number",
              "format": "double",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "const": "envelope"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "attack", "release"]
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "$ref": "#/$defs/SpatialBasisDSL"
            },
            "custom_order": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            },
            "from": {
              "type": "number",
              "format": "double"
            },
            "group_size": {
              "type": ["integer", "null"],
              "format": "uint32",
              "minimum": 0
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "to": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "spatial_phase"
            },
            "wrap": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "basis", "from", "to", "wrap"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "left": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "operation": {
              "$ref": "#/$defs/MathOperationDSL"
            },
            "right": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "type": {
              "type": "string",
              "const": "math"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "operation", "left", "right"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "input_range": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "output_range": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "map"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "input_range", "output_range"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "clamp"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "min", "max"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColorStopDSL"
              }
            },
            "type": {
              "type": "string",
              "const": "color_gradient"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "stops"]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "fixture_mask"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input", "min", "max"]
        },
        {
          "type": "object",
          "properties": {
            "attribute_id": {
              "type": ["string", "null"]
            },
            "id": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/EffectPortRefDSL"
            },
            "mask": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EffectPortRefDSL"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "attribute_writer"
            }
          },
          "additionalProperties": false,
          "required": ["type", "id", "input"]
        }
      ]
    },
    "EffectPortDSL": {
      "type": "string",
      "enum": ["scalar", "color", "direction", "mask", "attribute_set", "writes"]
    },
    "EffectPortRefDSL": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/EffectPortDSL"
        }
      },
      "additionalProperties": false,
      "required": ["node_id", "port"]
    },
    "EffectSourceDSL": {
      "type": "string",
      "enum": ["built_in", "project_local", "user_library"]
    },
    "MathOperationDSL": {
      "type": "string",
      "enum": ["add", "subtract", "multiply", "divide", "min", "max"]
    },
    "MotionTagDSL": {
      "type": "string",
      "enum": ["static", "pulse", "chase", "sweep", "organic"]
    },
    "OscillatorWaveformDSL": {
      "type": "string",
      "enum": ["sine", "triangle", "saw", "pulse"]
    },
    "ParameterDefinitionDSL": {
      "type": "object",
      "properties": {
        "automation": {
          "$ref": "#/$defs/AutomationPolicyDSL"
        },
        "default_value": {
          "$ref": "#/$defs/ParameterValueDSL"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "range": {
          "type": ["array", "null"],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "ui_hint": {
          "$ref": "#/$defs/ParameterUiHintDSL"
        },
        "unit": {
          "$ref": "#/$defs/ParameterUnitDSL"
        },
        "value_type": {
          "$ref": "#/$defs/ParameterValueTypeDSL"
        }
      },
      "additionalProperties": false,
      "required": ["id", "name", "value_type", "default_value", "unit", "ui_hint", "automation"]
    },
    "ParameterUiHintDSL": {
      "type": "string",
      "enum": ["slider", "color", "segmented", "angle"]
    },
    "ParameterUnitDSL": {
      "type": "string",
      "enum": ["multiplier", "cycles", "percent", "normalized", "color", "direction", "degrees"]
    },
    "ParameterValueDSL": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "direction"
            },
            "value": {
              "$ref": "#/$defs/DirectionDSL"
            }
          },
          "additionalProperties": false,
          "required": ["type", "value"]
        }
      ]
    },
    "ParameterValueTypeDSL": {
      "type": "string",
      "enum": ["scalar", "color", "direction"]
    },
    "PhaserStepDSL": {
      "type": "object",
      "properties": {
        "accel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "decel": {
          "type": ["integer", "null"],
          "format": "int32"
        },
        "transition": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "values": {
          "$ref": "#/$defs/StepValuesDSL"
        },
        "width": {
          "type": ["number", "null"],
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "required": ["values"]
    },
    "SpatialBasisDSL": {
      "type": "string",
      "enum": ["index", "x", "y", "distance", "angle", "custom"]
    },
    "StepValuesDSL": {
      "type": "object",
      "properties": {
        "color": {
          "type": ["string", "null"]
        },
        "dimmer": {
          "type": ["number", "null"],
          "format": "float",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "pan": {
          "type": ["number", "null"],
          "format": "float"
        },
        "tilt": {
          "type": ["number", "null"],
          "format": "float"
        }
      },
      "additionalProperties": false
    },
    "StrobeRiskDSL": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    }
  }
}
