{
  "schema_version": 1,
  "id": "builtin.transition.fade-crossfade",
  "name": "Fade / Crossfade",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced fade cycle."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Peak crossfade intensity."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color",
        "default": "#7C8DFF"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Single-color output override for Cue and Arrangement authoring."
    }
  ],
  "tempo": {
    "primary_event": "rise_fall_cycle",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "oscillator",
        "id": "fade-cycle",
        "waveform": "triangle",
        "phase": {
          "node_id": "time",
          "port": "scalar"
        }
      },
      {
        "type": "map",
        "id": "safe-level",
        "input": {
          "node_id": "fade-cycle",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [0.15, 1]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "safe-level",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "utility",
    "category": "Transition",
    "visibility": "standard",
    "mood": ["smooth", "controlled"],
    "energy": 0.3,
    "density": 1,
    "motion": "organic",
    "colorfulness": 0.75,
    "required_attributes": ["intensity", "color.rgb"],
    "layout_capabilities": ["any"]
  }
}
