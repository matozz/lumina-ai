{
  "schema_version": 1,
  "id": "builtin.movement.tilt-wave",
  "name": "Tilt Wave",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced tilt speed."
    },
    {
      "id": "phase",
      "name": "Phase",
      "schema": {
        "type": "scalar",
        "default": 0,
        "range": {
          "min": -1,
          "max": 1,
          "step": 0.05
        },
        "unit": "cycles"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Tilt cycle offset."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "kind": "continuous_cycle",
    "primary_event": "movement_cycle",
    "events_per_graph_cycle": 1,
    "one_x_events_per_beat": 1,
    "phase_anchor": "midpoint_rising",
    "topology_sensitivity": ["target_set", "fixture_order", "coordinates"],
    "recommended_speed": { "min": 0.25, "max": 2 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "spatial",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "index",
        "from": 0,
        "to": 0.5,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "sine",
        "phase": {
          "node_id": "spatial",
          "port": "scalar"
        }
      },
      {
        "type": "map",
        "id": "tilt-map",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [-60, 60]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "tilt-map",
          "port": "scalar"
        },
        "attribute_id": "position.tilt"
      },
      {
        "type": "constant",
        "id": "visible-intensity",
        "value": {
          "type": "scalar",
          "value": 1
        }
      },
      {
        "type": "attribute_writer",
        "id": "intensity-writer",
        "input": {
          "node_id": "visible-intensity",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "movement",
    "category": "Movement",
    "visibility": "standard",
    "mood": ["rolling", "kinetic"],
    "energy": 0.55,
    "density": 0.75,
    "motion": "organic",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["position.tilt", "intensity"],
    "layout_capabilities": ["linear", "matrix", "coordinates"]
  }
}
