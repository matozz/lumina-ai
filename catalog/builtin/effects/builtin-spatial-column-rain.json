{
  "schema_version": 1,
  "id": "builtin.spatial.column-rain",
  "name": "Seeded Column Rain",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced top-to-bottom rainfall speed."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.85,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Peak output of each falling column segment."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "kind": "one_way_travel",
    "primary_event": "one_way_traversal",
    "events_per_graph_cycle": 1,
    "one_x_events_per_beat": 1,
    "phase_anchor": "traversal_start",
    "topology_sensitivity": ["target_set", "coordinates"],
    "recommended_speed": { "min": 0.25, "max": 2 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "seeded-column-phase",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "random_x",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "spatial_phase",
        "id": "falling-row-phase",
        "input": {
          "node_id": "seeded-column-phase",
          "port": "scalar"
        },
        "basis": "y",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "fixture_mask",
        "id": "rain-head",
        "input": {
          "node_id": "falling-row-phase",
          "port": "scalar"
        },
        "min": 0,
        "max": 0.18
      },
      {
        "type": "constant",
        "id": "level",
        "value": {
          "type": "scalar",
          "value": 1
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "level",
          "port": "scalar"
        },
        "mask": {
          "node_id": "rain-head",
          "port": "mask"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Chases",
    "visibility": "standard",
    "mood": ["textured", "kinetic"],
    "energy": 0.65,
    "density": 0.35,
    "motion": "chase",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["matrix", "coordinates"]
  }
}
