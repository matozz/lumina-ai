{
  "schema_version": 1,
  "id": "builtin.spatial.column-rain",
  "name": "Seeded Column Rain",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "value_type": "scalar",
      "default_value": { "type": "scalar", "value": 1 },
      "range": [0.25, 8],
      "step": 0.25,
      "required": true,
      "help": "Beat-synced top-to-bottom rainfall speed.",
      "safe_fallback": { "type": "scalar", "value": 0.5 },
      "override_policy": "cue_override",
      "advanced": false,
      "unit": "multiplier",
      "ui_hint": "slider",
      "automation": "continuous"
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "value_type": "scalar",
      "default_value": { "type": "scalar", "value": 0.85 },
      "range": [0, 1],
      "step": 0.05,
      "required": true,
      "help": "Peak output of each falling column segment.",
      "safe_fallback": { "type": "scalar", "value": 0.45 },
      "override_policy": "cue_override",
      "advanced": false,
      "unit": "normalized",
      "ui_hint": "slider",
      "automation": "continuous"
    },
    {
      "id": "color",
      "name": "Color",
      "value_type": "color",
      "default_value": {
        "type": "color",
        "value": "#FFFFFF"
      },
      "default_enabled": false,
      "required": true,
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback.",
      "safe_fallback": {
        "type": "color",
        "value": "#FFFFFF"
      },
      "override_policy": "cue_override",
      "advanced": false,
      "unit": "color",
      "ui_hint": "color",
      "automation": "continuous"
    }
  ],
  "graph": {
    "nodes": [
      { "type": "time", "id": "time" },
      {
        "type": "spatial_phase",
        "id": "seeded-column-phase",
        "input": { "node_id": "time", "port": "scalar" },
        "basis": "random_x",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "spatial_phase",
        "id": "falling-row-phase",
        "input": { "node_id": "seeded-column-phase", "port": "scalar" },
        "basis": "y",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "fixture_mask",
        "id": "rain-head",
        "input": { "node_id": "falling-row-phase", "port": "scalar" },
        "min": 0,
        "max": 0.18
      },
      { "type": "constant", "id": "level", "value": { "type": "scalar", "value": 1 } },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": { "node_id": "level", "port": "scalar" },
        "mask": { "node_id": "rain-head", "port": "mask" },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Chases",
    "visibility": "standard",
    "mood": ["textured", "kinetic"],
    "energy": 0.65,
    "density": 0.35,
    "motion": "chase",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["matrix", "coordinates"],
    "parameter_summary": ["speed", "intensity"],
    "deprecated": false
  }
}
