{
  "schema_version": 1,
  "id": "builtin.movement.pan-sweep",
  "name": "Pan Sweep",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced pan speed."
    },
    {
      "id": "direction",
      "name": "Direction",
      "schema": {
        "type": "direction",
        "default": "forward"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Sweep travel direction."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "sine",
        "phase": {
          "node_id": "time",
          "port": "scalar"
        }
      },
      {
        "type": "map",
        "id": "pan-map",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [-180, 180]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "pan-map",
          "port": "scalar"
        },
        "attribute_id": "position.pan"
      },
      {
        "type": "constant",
        "id": "visible-intensity",
        "value": {
          "type": "scalar",
          "value": 1
        }
      },
      {
        "type": "attribute_writer",
        "id": "intensity-writer",
        "input": {
          "node_id": "visible-intensity",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "movement",
    "category": "Movement",
    "visibility": "standard",
    "mood": ["searching", "wide"],
    "energy": 0.5,
    "density": 0.7,
    "motion": "sweep",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["position.pan", "intensity"],
    "layout_capabilities": ["any"]
  }
}
