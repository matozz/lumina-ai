{
  "schema_version": 1,
  "id": "builtin.intensity.chase",
  "name": "Column Half Relay",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized relay rate; 1× crosses to the opposite column half each beat and returns on the next."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum relay brightness."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "primary_event": "directional_traversal",
    "events_per_graph_cycle": 2
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "constant",
        "id": "phase-quarter",
        "value": {
          "type": "scalar",
          "value": 0.25
        }
      },
      {
        "type": "math",
        "id": "phase-anchor",
        "operation": "add",
        "left": {
          "node_id": "time",
          "port": "scalar"
        },
        "right": {
          "node_id": "phase-quarter",
          "port": "scalar"
        }
      },
      {
        "type": "spatial_phase",
        "id": "column-halves",
        "input": {
          "node_id": "phase-anchor",
          "port": "scalar"
        },
        "basis": "x",
        "from": 0,
        "to": 1,
        "wrap": true,
        "partition_count": 2,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "relay-wave",
        "waveform": "sine",
        "phase": {
          "node_id": "column-halves",
          "port": "scalar"
        }
      },
      {
        "type": "map",
        "id": "soft-relay",
        "input": {
          "node_id": "relay-wave",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [0.12, 1]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "soft-relay",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Chases",
    "visibility": "standard",
    "mood": ["balanced", "kinetic"],
    "energy": 0.62,
    "density": 0.75,
    "motion": "sweep",
    "colorfulness": 0,
    "required_attributes": ["intensity"],
    "layout_capabilities": ["linear", "matrix", "coordinates"]
  }
}
