{
  "schema_version": 1,
  "id": "builtin.intensity.chase",
  "name": "Alternating Grid Chase",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized chase rate; 1× completes one ordered traversal per beat."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum chase output."
    },
    {
      "id": "direction",
      "name": "Direction",
      "schema": {
        "type": "direction",
        "default": "forward"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Chase travel direction."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "primary_event": "one_way_traversal",
    "events_per_graph_cycle": 1,
    "safety": { "max_primary_events_per_second": 4 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "spatial",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "index",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "pulse",
        "duty_cycle": 0.4,
        "phase": {
          "node_id": "spatial",
          "port": "scalar"
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Chases",
    "visibility": "standard",
    "mood": ["driving", "kinetic"],
    "energy": 0.8,
    "density": 0.45,
    "motion": "chase",
    "colorfulness": 0,
    "strobe_risk": "high",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["linear", "matrix", "coordinates"]
  }
}
