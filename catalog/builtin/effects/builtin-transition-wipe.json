{
  "schema_version": 1,
  "id": "builtin.transition.wipe",
  "name": "Spatial Wipe",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced wipe travel speed."
    },
    {
      "id": "phase",
      "name": "Phase",
      "schema": {
        "type": "scalar",
        "default": 0,
        "range": {
          "min": -1,
          "max": 1,
          "step": 0.01
        },
        "unit": "cycles"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Spatial wipe offset in cycles."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Peak wipe intensity."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "primary_event": "one_way_traversal",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "wipe-position",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "x",
        "from": -0.75,
        "to": 0.75,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "wipe-edge",
        "waveform": "saw",
        "phase": {
          "node_id": "wipe-position",
          "port": "scalar"
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "wipe-edge",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Transition",
    "visibility": "standard",
    "mood": ["directional", "clean"],
    "energy": 0.55,
    "density": 0.55,
    "motion": "sweep",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["linear", "matrix", "coordinates"]
  }
}
