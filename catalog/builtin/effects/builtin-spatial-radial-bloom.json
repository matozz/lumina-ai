{
  "schema_version": 1,
  "id": "builtin.spatial.radial-bloom",
  "name": "Center-out / Edge-in Bloom",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced radial speed."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color",
        "default": "#6E8BFF"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Single-color output override for Cue and Arrangement authoring."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.9,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum bloom output."
    },
    {
      "id": "direction",
      "name": "Direction",
      "schema": {
        "type": "direction",
        "default": "forward"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Outward or inward travel."
    }
  ],
  "tempo": {
    "kind": "spatial_propagation",
    "primary_event": "spatial_propagation",
    "events_per_graph_cycle": 1,
    "one_x_events_per_beat": 1,
    "phase_anchor": "midpoint_rising",
    "topology_sensitivity": ["target_set", "coordinates"],
    "recommended_speed": { "min": 0.25, "max": 2 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "spatial",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "distance",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "sine",
        "phase": {
          "node_id": "spatial",
          "port": "scalar"
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Geometry",
    "visibility": "standard",
    "mood": ["expansive", "cinematic"],
    "energy": 0.55,
    "density": 0.8,
    "motion": "organic",
    "colorfulness": 0.75,
    "strobe_risk": "none",
    "required_attributes": ["intensity", "color.rgb"],
    "layout_capabilities": ["coordinates", "radial"]
  }
