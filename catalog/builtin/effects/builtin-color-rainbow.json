{
  "schema_version": 1,
  "id": "builtin.color.rainbow",
  "name": "Slow Color Shimmer",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced color travel speed."
    },
    {
      "id": "phase",
      "name": "Phase",
      "schema": {
        "type": "scalar",
        "default": 0,
        "range": {
          "min": -1,
          "max": 1,
          "step": 0.05
        },
        "unit": "cycles"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Color cycle offset."
    },
    {
      "id": "palette",
      "name": "Palette",
      "schema": {
        "type": "color_stops",
        "default": [
          {
            "position": 0,
            "color": "#FF245D"
          },
          {
            "position": 0.33,
            "color": "#FFD84A"
          },
          {
            "position": 0.66,
            "color": "#36E6A5"
          },
          {
            "position": 1,
            "color": "#5B7CFF"
          }
        ]
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Ordered colors used by the flow.",
      "graph_binding": {
        "node_id": "gradient",
        "property": "color_stops"
      }
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "spatial",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "x",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "color_gradient",
        "id": "gradient",
        "input": {
          "node_id": "spatial",
          "port": "scalar"
        },
        "stops": [
          {
            "position": 0,
            "color": "#FF245D"
          },
          {
            "position": 0.33,
            "color": "#FFD84A"
          },
          {
            "position": 0.66,
            "color": "#36E6A5"
          },
          {
            "position": 1,
            "color": "#5B7CFF"
          }
        ]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "gradient",
          "port": "color"
        },
        "attribute_id": "color.rgb"
      },
      {
        "type": "constant",
        "id": "visible-intensity",
        "value": {
          "type": "scalar",
          "value": 1
        }
      },
      {
        "type": "attribute_writer",
        "id": "intensity-writer",
        "input": {
          "node_id": "visible-intensity",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "color",
    "category": "Color Motion",
    "visibility": "standard",
    "mood": ["festival", "bright"],
    "energy": 0.7,
    "density": 0.85,
    "motion": "sweep",
    "colorfulness": 1,
    "strobe_risk": "none",
    "required_attributes": ["color.rgb", "intensity"],
    "layout_capabilities": ["coordinates"]
  }
}
