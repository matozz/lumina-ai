{
  "schema_version": 1,
  "id": "builtin.intensity.wave",
  "name": "Strip / Bar Traveler",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Beat-synced wave speed."
    },
    {
      "id": "phase",
      "name": "Phase",
      "schema": {
        "type": "scalar",
        "default": 0,
        "range": {
          "min": -1,
          "max": 1,
          "step": 0.05
        },
        "unit": "cycles"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Cycle offset across the layout."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum wave output."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "primary_event": "spatial_propagation",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "spatial_phase",
        "id": "spatial",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "basis": "x",
        "from": 0,
        "to": 1,
        "wrap": true,
        "custom_order": []
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "sine",
        "phase": {
          "node_id": "spatial",
          "port": "scalar"
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Waves",
    "visibility": "standard",
    "mood": ["fluid", "wide"],
    "energy": 0.55,
    "density": 0.7,
    "motion": "sweep",
    "colorfulness": 0,
    "required_attributes": ["intensity"],
    "layout_capabilities": ["coordinates"]
  }
}
