{
  "schema_version": 1,
  "id": "builtin.spatial.column-center-ripple",
  "name": "Column Center Ripple",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.5,
        "range": { "min": 0.25, "max": 8, "step": 0.25 },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "One center-to-outer-column ripple per beat at 1×."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.9,
        "range": { "min": 0, "max": 1, "step": 0.05 },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum ripple brightness."
    },
    {
      "id": "direction",
      "name": "Direction",
      "schema": { "type": "direction", "default": "forward" },
      "scope": "arrangement",
      "section": "main",
      "help": "Center-out or outer-in ripple direction."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": { "type": "color", "default": "#67E8F9" },
      "scope": "arrangement",
      "section": "main",
      "help": "Color of the center ripple."
    }
  ],
  "tempo": {
    "primary_event": "spatial_propagation",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      { "type": "time", "id": "time" },
      {
        "type": "spatial_phase",
        "id": "center-bands",
        "input": { "node_id": "time", "port": "scalar" },
        "basis": "x_distance",
        "from": 0,
        "to": 1,
        "wrap": true,
        "partition_count": 3
      },
      {
        "type": "oscillator",
        "id": "ripple-wave",
        "waveform": "sine",
        "phase": { "node_id": "center-bands", "port": "scalar" }
      },
      {
        "type": "map",
        "id": "soft-ripple",
        "input": { "node_id": "ripple-wave", "port": "scalar" },
        "input_range": [0, 1],
        "output_range": [0.08, 1]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": { "node_id": "soft-ripple", "port": "scalar" },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Column Phrases",
    "visibility": "standard",
    "mood": ["expansive", "architectural"],
    "energy": 0.58,
    "density": 0.8,
    "motion": "organic",
    "colorfulness": 0.75,
    "required_attributes": ["intensity", "color.rgb"],
    "layout_capabilities": ["matrix", "coordinates"]
  }
}
