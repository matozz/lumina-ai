{
  "schema_version": 1,
  "id": "builtin.strobe.safe-pulse",
  "name": "Safe Strobe Pulse",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized flash rate; 1× is one short onset per beat. Review measured Hz before use."
    },
    {
      "id": "duty_cycle",
      "name": "Duty cycle",
      "schema": {
        "type": "scalar",
        "default": 0.125,
        "range": {
          "min": 0.05,
          "max": 0.25,
          "step": 0.025
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fraction of each flash cycle that remains on.",
      "graph_binding": {
        "node_id": "oscillator",
        "property": "duty_cycle"
      }
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.65,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Maximum flash intensity."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "kind": "pulse",
    "primary_event": "pulse_onset",
    "events_per_graph_cycle": 1,
    "one_x_events_per_beat": 1,
    "phase_anchor": "onset",
    "duty_cycle": 0.125,
    "topology_sensitivity": ["target_set"],
    "recommended_speed": { "min": 0.25, "max": 1 },
    "safety": { "max_primary_events_per_second": 3 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "pulse",
        "duty_cycle": 0.125,
        "phase": {
          "node_id": "time",
          "port": "scalar"
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "strobe",
    "category": "Risk",
    "visibility": "standard",
    "mood": ["impact", "peak"],
    "energy": 0.9,
    "density": 0.4,
    "motion": "pulse",
    "colorfulness": 0,
    "strobe_risk": "high",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["any"]
  }
}
