{
  "schema_version": 1,
  "id": "builtin.spatial.column-ping-pong",
  "name": "Column Ping-Pong",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized travel rate; 1× crosses in one direction per beat and returns on the next."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.9,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Peak output of the traveling column."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Optional single-color override. Clear it to use the Effect color or intensity fallback."
    }
  ],
  "tempo": {
    "kind": "ping_pong",
    "primary_event": "directional_traversal",
    "events_per_graph_cycle": 2,
    "one_x_events_per_beat": 1,
    "phase_anchor": "traversal_start",
    "direction_reversals_per_graph_cycle": 2,
    "topology_sensitivity": ["target_set", "coordinates"],
    "recommended_speed": { "min": 0.25, "max": 2 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "oscillator",
        "id": "travel-position",
        "waveform": "triangle",
        "phase": {
          "node_id": "time",
          "port": "scalar"
        }
      },
      {
        "type": "map",
        "id": "endpoint-overrun",
        "input": {
          "node_id": "travel-position",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [-0.08, 1.08]
      },
      {
        "type": "clamp",
        "id": "endpoint-dwell",
        "input": {
          "node_id": "endpoint-overrun",
          "port": "scalar"
        },
        "min": 0,
        "max": 1
      },
      {
        "type": "spatial_phase",
        "id": "column-distance",
        "input": {
          "node_id": "endpoint-dwell",
          "port": "scalar"
        },
        "basis": "x",
        "from": 0,
        "to": 1,
        "wrap": false,
        "custom_order": []
      },
      {
        "type": "fixture_mask",
        "id": "traveling-column",
        "input": {
          "node_id": "column-distance",
          "port": "scalar"
        },
        "min": -0.065,
        "max": 0.065
      },
      {
        "type": "constant",
        "id": "level",
        "value": {
          "type": "scalar",
          "value": 1
        }
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "level",
          "port": "scalar"
        },
        "mask": {
          "node_id": "traveling-column",
          "port": "mask"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "spatial",
    "category": "Chases",
    "visibility": "standard",
    "mood": ["playful", "kinetic"],
    "energy": 0.7,
    "density": 0.3,
    "motion": "chase",
    "colorfulness": 0,
    "strobe_risk": "none",
    "required_attributes": ["intensity"],
    "layout_capabilities": ["matrix", "coordinates"]
  }
}
