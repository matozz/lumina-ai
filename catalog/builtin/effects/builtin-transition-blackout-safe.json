{
  "schema_version": 1,
  "id": "builtin.transition.blackout-safe",
  "name": "Blackout-safe Transition",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 0.25,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized transition rate; 1× produces one fade-in/fade-out cycle per beat."
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color",
        "default": "#FFFFFF"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Single-color output override for Cue and Arrangement authoring."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 0.7,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Safe capped transition intensity."
    },
    {
      "id": "attack",
      "name": "Attack",
      "schema": {
        "type": "scalar",
        "default": 0.35,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fade-in envelope fraction.",
      "graph_binding": {
        "node_id": "safe-envelope",
        "property": "attack"
      }
    },
    {
      "id": "release",
      "name": "Release",
      "schema": {
        "type": "scalar",
        "default": 0.65,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fade-out envelope fraction.",
      "graph_binding": {
        "node_id": "safe-envelope",
        "property": "release"
      }
    }
  ],
  "tempo": {
    "primary_event": "rise_fall_cycle",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "envelope",
        "id": "safe-envelope",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "attack": 0.35,
        "release": 0.65
      },
      {
        "type": "map",
        "id": "safe-cap",
        "input": {
          "node_id": "safe-envelope",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [0, 0.7]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "safe-cap",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "utility",
    "category": "Transition",
    "visibility": "standard",
    "mood": ["safe", "controlled"],
    "energy": 0.15,
    "density": 1,
    "motion": "organic",
    "colorfulness": 0.75,
    "strobe_risk": "none",
    "required_attributes": ["intensity", "color.rgb"],
    "layout_capabilities": ["any"]
  }
}
