{
  "schema_version": 1,
  "id": "builtin.color.pulse",
  "name": "Short Color Burst",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized burst rate; 1× produces one short onset per beat."
    },
    {
      "id": "duty_cycle",
      "name": "Duty cycle",
      "schema": {
        "type": "scalar",
        "default": 0.2,
        "range": {
          "min": 0.05,
          "max": 0.5,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fraction of each event cycle that remains visibly on.",
      "graph_binding": {
        "node_id": "oscillator",
        "property": "duty_cycle"
      }
    },
    {
      "id": "palette",
      "name": "Palette",
      "schema": {
        "type": "color_stops",
        "default": [
          {
            "position": 0,
            "color": "#190D3B"
          },
          {
            "position": 1,
            "color": "#FF4FD8"
          }
        ]
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Dark-to-bright pulse colors.",
      "graph_binding": {
        "node_id": "gradient",
        "property": "color_stops"
      }
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Single-color output override for Cue and Arrangement authoring."
    }
  ],
  "tempo": {
    "kind": "pulse",
    "primary_event": "pulse_onset",
    "events_per_graph_cycle": 1,
    "one_x_events_per_beat": 1,
    "phase_anchor": "onset",
    "duty_cycle": 0.2,
    "topology_sensitivity": ["target_set"],
    "recommended_speed": { "min": 0.25, "max": 1 },
    "safety": { "max_primary_events_per_second": 3 }
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "oscillator",
        "id": "oscillator",
        "waveform": "pulse",
        "duty_cycle": 0.2,
        "phase": {
          "node_id": "time",
          "port": "scalar"
        }
      },
      {
        "type": "color_gradient",
        "id": "gradient",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "stops": [
          {
            "position": 0,
            "color": "#190D3B"
          },
          {
            "position": 1,
            "color": "#FF4FD8"
          }
        ]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "gradient",
          "port": "color"
        },
        "attribute_id": "color.rgb"
      },
      {
        "type": "map",
        "id": "visible-intensity",
        "input": {
          "node_id": "oscillator",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [0, 1]
      },
      {
        "type": "attribute_writer",
        "id": "intensity-writer",
        "input": {
          "node_id": "visible-intensity",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "color",
    "category": "Rhythm",
    "visibility": "standard",
    "mood": ["neon", "club"],
    "energy": 0.65,
    "density": 0.6,
    "motion": "pulse",
    "colorfulness": 0.9,
    "strobe_risk": "high",
    "required_attributes": ["color.rgb", "intensity"],
    "layout_capabilities": ["any"]
  }
}
