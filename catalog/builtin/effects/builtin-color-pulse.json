{
  "schema_version": 1,
  "id": "builtin.color.pulse",
  "name": "Color Accent",
  "revision": 1,
  "source": "built_in",
  "parameters": [
    {
      "id": "speed",
      "name": "Speed",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0.25,
          "max": 8,
          "step": 0.25
        },
        "unit": "multiplier"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Normalized accent rate; 1× produces one smooth rise-fall accent per beat."
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "schema": {
        "type": "scalar",
        "default": 1,
        "range": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Peak brightness of the color accent."
    },
    {
      "id": "attack",
      "name": "Attack",
      "schema": {
        "type": "scalar",
        "default": 0.18,
        "range": {
          "min": 0.05,
          "max": 0.45,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fraction of the cycle used to fade into the accent.",
      "graph_binding": {
        "node_id": "accent-envelope",
        "property": "attack"
      }
    },
    {
      "id": "release",
      "name": "Release",
      "schema": {
        "type": "scalar",
        "default": 0.55,
        "range": {
          "min": 0.25,
          "max": 0.8,
          "step": 0.05
        },
        "unit": "normalized"
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Fraction of the cycle used to fade out of the accent.",
      "graph_binding": {
        "node_id": "accent-envelope",
        "property": "release"
      }
    },
    {
      "id": "palette",
      "name": "Palette",
      "schema": {
        "type": "color_stops",
        "default": [
          {
            "position": 0,
            "color": "#7A5AAE"
          },
          {
            "position": 1,
            "color": "#FF4FD8"
          }
        ]
      },
      "scope": "effect",
      "section": "advanced",
      "help": "Chromatic accent colors; brightness is shaped by the intensity envelope instead of black color mixing.",
      "graph_binding": {
        "node_id": "gradient",
        "property": "color_stops"
      }
    },
    {
      "id": "color",
      "name": "Color",
      "schema": {
        "type": "color"
      },
      "scope": "arrangement",
      "section": "main",
      "help": "Single-color output override for Cue and Arrangement authoring."
    }
  ],
  "tempo": {
    "primary_event": "rise_fall_cycle",
    "events_per_graph_cycle": 1
  },
  "graph": {
    "nodes": [
      {
        "type": "time",
        "id": "time"
      },
      {
        "type": "envelope",
        "id": "accent-envelope",
        "input": {
          "node_id": "time",
          "port": "scalar"
        },
        "attack": 0.18,
        "release": 0.55
      },
      {
        "type": "color_gradient",
        "id": "gradient",
        "input": {
          "node_id": "accent-envelope",
          "port": "scalar"
        },
        "stops": [
          {
            "position": 0,
            "color": "#7A5AAE"
          },
          {
            "position": 1,
            "color": "#FF4FD8"
          }
        ]
      },
      {
        "type": "attribute_writer",
        "id": "writer",
        "input": {
          "node_id": "gradient",
          "port": "color"
        },
        "attribute_id": "color.rgb"
      },
      {
        "type": "map",
        "id": "visible-intensity",
        "input": {
          "node_id": "accent-envelope",
          "port": "scalar"
        },
        "input_range": [0, 1],
        "output_range": [0.12, 1]
      },
      {
        "type": "attribute_writer",
        "id": "intensity-writer",
        "input": {
          "node_id": "visible-intensity",
          "port": "scalar"
        },
        "attribute_id": "intensity"
      }
    ]
  },
  "catalog": {
    "family": "color",
    "category": "Rhythm",
    "visibility": "standard",
    "mood": ["neon", "warm"],
    "energy": 0.6,
    "density": 0.75,
    "motion": "organic",
    "colorfulness": 0.9,
    "required_attributes": ["color.rgb", "intensity"],
    "layout_capabilities": ["any"]
  }
}
