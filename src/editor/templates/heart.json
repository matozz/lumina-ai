{
  "schema_version": 2,
  "meta": {
    "name": "Heart Show"
  },
  "patch": [
    {
      "profile_id": "generic-moving-head",
      "id_range": [
        1,
        80
      ]
    }
  ],
  "layout": {
    "type": "generator",
    "generator": {
      "shape": "formula",
      "formula": {
        "x": "16 * pow(sin(t), 3)",
        "y": "-(13*cos(t) - 5*cos(2*t) - 2*cos(3*t) - cos(4*t))",
        "t_range": [
          0,
          6.283185
        ],
        "count": 80,
        "scale": 10
      }
    }
  },
  "groups": [
    {
      "id": "all",
      "name": "All",
      "fixtures": {
        "range": [
          1,
          80
        ]
      },
      "sort_by": "none"
    },
    {
      "id": "byx",
      "name": "ByX",
      "fixtures": {
        "range": [
          1,
          80
        ]
      },
      "sort_by": "x"
    },
    {
      "id": "byangle",
      "name": "ByAngle",
      "fixtures": {
        "range": [
          1,
          80
        ]
      },
      "sort_by": "angle_center"
    }
  ],
  "phasers": [
    {
      "id": "heart_beat",
      "name": "Heart Beat",
      "target": "all",
      "steps": [
        {
          "values": {
            "color": "#ff0055",
            "dimmer": 1
          },
          "width": 30,
          "transition": 100,
          "accel": -100,
          "decel": -100
        },
        {
          "values": {
            "color": "#330011",
            "dimmer": 0.2
          },
          "width": 70,
          "transition": 80
        }
      ],
      "phase": {
        "mode": "spread",
        "spread": {
          "from": 0,
          "to": 0
        }
      }
    },
    {
      "id": "chase",
      "name": "Chase",
      "target": "byangle",
      "multiplier": 2,
      "steps": [
        {
          "values": {
            "color": "#ff0000",
            "dimmer": 1
          },
          "width": 20,
          "transition": 0
        },
        {
          "values": {
            "color": "#000000",
            "dimmer": 0
          },
          "width": 80,
          "transition": 0
        }
      ],
      "phase": {
        "mode": "spread",
        "spread": {
          "from": 0,
          "to": 100
        }
      }
    }
  ]
}
