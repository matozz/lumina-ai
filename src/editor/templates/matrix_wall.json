{
  "meta": { "name": "Matrix Wall" },
  "patch": [{ "type": "wash", "color": "rgb", "idRange": [1, 96] }],
  "layout": {
    "type": "generator",
    "generator": {
      "shape": "matrix",
      "rows": 4,
      "columns": 24,
      "spacing": 20,
      "origin": [0, 0]
    }
  },
  "groups": [
    { "name": "All", "fixtures": { "range": [1, 96] }, "sortBy": "x" },
    { "name": "ByY", "fixtures": { "range": [1, 96] }, "sortBy": "y" },
    { "name": "ByCenter", "fixtures": { "range": [1, 96] }, "sortBy": "distance_center" }
  ],
  "presets": [],
  "phasers": [
    {
      "name": "Horizontal Color Band",
      "target": "All",
      "multiplier": 1.0,
      "steps": [
        { "values": { "color": "#ff0088", "dimmer": 1.0 }, "width": 20, "transition": 100 },
        { "values": { "color": "#002244", "dimmer": 0.2 }, "width": 80, "transition": 100 }
      ],
      "phase": { "mode": "mirror", "spread": { "from": 0, "to": 360 } }
    },
    {
      "name": "Vertical Rain",
      "target": "ByY",
      "multiplier": 2.0,
      "steps": [
        { "values": { "dimmer": 1.0, "color": "#ffffff" }, "width": 10, "transition": 0 },
        { "values": { "dimmer": 0.0, "color": "#000000" }, "width": 90, "transition": 50 }
      ],
      "phase": { "mode": "spread", "spread": { "from": 0, "to": 360 } }
    },
    {
      "name": "Center Pulse",
      "target": "ByCenter",
      "multiplier": 0.5,
      "steps": [
        { "values": { "color": "#00ffff", "dimmer": 1.0 }, "width": 10, "transition": 0 },
        { "values": { "color": "#000000", "dimmer": 0.0 }, "width": 90, "transition": 100 }
      ],
      "phase": { "mode": "spread", "spread": { "from": 0, "to": 180 } }
    }
  ],
  "sequences": [],
  "timeline": {
    "bpm": 120,
    "events": []
  }
}
